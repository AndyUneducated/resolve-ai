# ---------- LLM Providers ----------
# 本地优先：Ollama（无需 ANTHROPIC / OPENAI key）。LangChain `ChatOllama` 直连。
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Fallback / 演示用云模型，仅当 LLM_BACKEND=anthropic 时读取
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cost-aware routing（与本机 Ollama 对齐：`ollama list`）
# 默认双 9B 便于本机快速验证；要更好质量可把 VERTICAL_MODEL 改为 qwen3.6:27b（随时可改，重启 API 生效）
TRIAGE_MODEL=qwen3.5:9b
VERTICAL_MODEL=qwen3.5:9b

# ---------- Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=resolveai
POSTGRES_DB=resolveai
DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5432/resolveai

# postgres (default) | memory — memory makes the API runnable without a DB (used in tests)
CHECKPOINT_BACKEND=postgres

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- MCP Servers (本地 dev 用 stdio；生产可切 HTTP) ----------
MCP_TRANSPORT=stdio
# M3: all 5 mock MCP servers now run real stdio (deterministic in-memory data).
# Each `python -m mcp_servers.<name>` becomes a subprocess that the API discovers
# at startup via langchain-mcp-adapters MultiServerMCPClient.
MCP_STRIPE_CMD=python -m mcp_servers.stripe
MCP_ZENDESK_CMD=python -m mcp_servers.zendesk
MCP_SLACK_CMD=python -m mcp_servers.slack
MCP_SALESFORCE_CMD=python -m mcp_servers.salesforce
MCP_INTERCOM_CMD=python -m mcp_servers.intercom
SANDBOX_MODE=off                # off | docker | gvisor
MCP_SANDBOX_IMAGE=resolveai/mcp-servers:dev

# ---------- Guardrails ----------
LLAMA_GUARD_ENDPOINT=
LLAMA_GUARD_MODEL=llama-guard3:8b
LLAMA_GUARD_TIMEOUT_MS=2000
PRESIDIO_ENDPOINT=
PRESIDIO_LANGUAGE=en
POLICY_JUDGE_MODEL=qwen3.5:9b
POLICY_JUDGE_TIMEOUT_MS=1500
GVISOR_RUNTIME=runsc            # 本地无 gVisor 时降级为 runc + 容量白名单
GUARDRAIL_L1=on
GUARDRAIL_L2=on
GUARDRAIL_L3=on
GUARDRAIL_L4=on

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=resolveai-api
EVALGATE_ENDPOINT=

# ---------- Multi-tenant (stretch) ----------
DEFAULT_TENANT_ID=demo
