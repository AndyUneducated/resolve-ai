# ---------- LLM Providers ----------
# 本地优先：Ollama（无需 ANTHROPIC / OPENAI key）。LangChain `ChatOllama` 直连。
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Fallback / 演示用云模型，仅当 LLM_BACKEND=anthropic 时读取
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cost-aware routing（与本机 Ollama 对齐：`ollama list`）
# 默认双 9B 便于本机快速验证；要更好质量可把 VERTICAL_MODEL 改为 qwen3.6:27b（随时可改，重启 API 生效）
TRIAGE_MODEL=qwen3.5:9b
VERTICAL_MODEL=qwen3.5:9b

# ---------- Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=resolveai
POSTGRES_DB=resolveai
# Owner / superuser DSN: migrations, seed, LangGraph checkpoint setup.
DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5432/resolveai
# Low-privilege app DSN (NOSUPERUSER NOBYPASSRLS role created by 0001_rls.sql).
# Tenant-scoped queries (KbStore etc.) connect with this so Row-Level Security is
# actually enforced — superusers silently bypass RLS, which is why this exists.
# A fresh `docker compose up` provisions the resolveai_app role automatically;
# for a pre-existing volume run `make db-migrate` once.
APP_DATABASE_URL=postgresql+psycopg://resolveai_app:resolveai_app@localhost:5432/resolveai

# postgres (default) | memory — memory makes the API runnable without a DB (used in tests)
CHECKPOINT_BACKEND=postgres

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- MCP Servers (本地 dev 用 stdio；生产可切 HTTP) ----------
MCP_TRANSPORT=stdio
# M3: all 5 mock MCP servers now run real stdio (deterministic in-memory data).
# Each `python -m mcp_servers.<name>` becomes a subprocess that the API discovers
# at startup via langchain-mcp-adapters MultiServerMCPClient.
MCP_STRIPE_CMD=python -m mcp_servers.stripe
MCP_ZENDESK_CMD=python -m mcp_servers.zendesk
MCP_SLACK_CMD=python -m mcp_servers.slack
MCP_SALESFORCE_CMD=python -m mcp_servers.salesforce
MCP_INTERCOM_CMD=python -m mcp_servers.intercom
# M10 sandbox backend: off (metadata only) | subprocess (POSIX rlimits) |
# container (gVisor/runc) | auto (container if runtime present, else subprocess).
SANDBOX_MODE=off
MCP_SANDBOX_IMAGE=resolveai/mcp-servers:dev
# Per tool-call blast-radius budget (M10). Enforced by the container tier fully;
# subprocess tier enforces cpu/mem/procs/file-size/wall-time (not fs/network).
SANDBOX_CPU_SECONDS=5
SANDBOX_MEMORY_MB=256
SANDBOX_WALL_TIMEOUT_S=10
SANDBOX_MAX_PROCESSES=64
SANDBOX_MAX_FILE_MB=16
SANDBOX_NETWORK=none             # none | allowlist
# App profile: demo (fail-open, favor availability) | production (fail-closed +
# sandbox enforced by default).
ENV_PROFILE=demo

# ---------- Guardrails ----------
LLAMA_GUARD_ENDPOINT=
# Must match a tag in `ollama list` (eval prereq check is prefix-tolerant but the
# model must be installed). 8b = more accurate/slower; 1b = faster/weaker (more
# false S1 positives on benign refunds). Pick what you've pulled.
LLAMA_GUARD_MODEL=llama-guard3:8b
LLAMA_GUARD_TIMEOUT_MS=2000
PRESIDIO_ENDPOINT=
PRESIDIO_LANGUAGE=en
# Entity types NOT treated as PII (redaction scope only — does not change blocking).
# DATE_TIME fires on benign "yesterday"/"last month" → noisy pii:date_time flags.
# Comma-separated; set empty to redact every detected type.
PRESIDIO_IGNORED_ENTITIES=DATE_TIME
POLICY_JUDGE_MODEL=qwen3.5:9b
# Local Ollama judges need a generous budget; 1500ms times out constantly under a
# 27B model. Raised default below — lower it only against a fast hosted endpoint.
POLICY_JUDGE_TIMEOUT_MS=8000
GVISOR_RUNTIME=runsc            # 本地无 gVisor 时降级为 runc + 容量白名单
GUARDRAIL_L1=on
GUARDRAIL_L2=on
GUARDRAIL_L3=on
GUARDRAIL_L4=on
# on = 后端不可用/超时则硬拦截（生产安全姿态）；off = 降级放行；
# auto = 跟随 ENV_PROFILE（production→硬拦截，demo→放行）。
GUARDRAIL_FAIL_CLOSED=auto

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=resolveai-api
EVALGATE_ENDPOINT=
# Eval→数据飞轮（M14）：设置后每个终态 ticket 追加一行 PII 脱敏 JSON 到该文件
# （best-effort，绝不影响请求）。喂给 scripts/harvest_traces.py 采样成版本化数据集。
# 空（默认）= 关闭。
TRACE_SINK_PATH=
# 每 ticket 建模成本预算（USD）。运行累计成本超过该值时，垂直 Plan-Execute/ReAct
# 循环停止继续花钱（保护性降级），Supervisor 打 cost:budget_exceeded 并计入
# resolveai_cost_budget_exceeded_total。<=0 关闭熔断。demo 默认宽松，生产收紧。
COST_BUDGET_USD=0.05

# ---------- Human-in-the-Loop (M12) ----------
# destructive 动作（refund/escalate…）的人工审批闸：
# off（默认，无闸，与 M12 前逐字节一致）| destructive（每个 destructive 工具调用
# 挂起待人工 approve/deny/edit）| auto（跟随 ENV_PROFILE：production→destructive）。
# 挂起时 /chat 发 awaiting_approval 事件；approve 后重放恢复。
APPROVAL_MODE=off

# ---------- Semantic cache (M13) ----------
# KB 检索的 embedding 近邻语义缓存：命中即复用检索结果，跳过 dense/lexical/rerank。
# off（默认，与 M13 前逐字节一致）| on。缓存按 tenant 隔离（不跨租户串答案）。
SEMANTIC_CACHE_ENABLED=off
SEMANTIC_CACHE_THRESHOLD=0.95   # 余弦相似度阈值，≥ 判定命中（越高越保守）
SEMANTIC_CACHE_TTL_S=3600       # 条目 TTL（秒），过期即失效；<=0 不过期
SEMANTIC_CACHE_MAX_ENTRIES=512  # 每进程容量上限，超出按最旧淘汰

# ---------- Multi-tenant (stretch) ----------
DEFAULT_TENANT_ID=demo
